---
// Polices auto-hébergées : pas de requête tierce, pas de FOUT.
import '@fontsource/anton';
import '@fontsource-variable/nunito';
import '@fontsource/caveat/600.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  // Pages utilitaires (affiche à imprimer) : inutile de les référencer.
  noindex?: boolean;
}

// `base` est pris en compte : les chemins absolus doivent en tenir compte.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const {
  title = 'LÜM — Lille Centre',
  description = 'Coffee & Lunch to go — LÜM Lille Centre, 64 rue du Molinel',
  noindex = false,
} = Astro.props;

// Données structurées de l'établissement, pour les moteurs de recherche.
// Les URL dérivent de `site` (astro.config.mjs) afin de rester cohérentes.
// Ne renseigner ici que des informations vérifiées : ces champs alimentent
// les fiches des moteurs, une valeur inventée y serait publiée telle quelle.
const donneesStructurees = {
  '@context': 'https://schema.org',
  '@type': 'CafeOrCoffeeShop',
  '@id': new URL('#etablissement', Astro.site).href,
  name: 'LÜM Lille Centre',
  description: "Coffee shop et vente à emporter au 64 rue du Molinel, à Lille.",
  url: Astro.site.href,
  telephone: '+33642996242',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '64 rue du Molinel',
    postalCode: '59800',
    addressLocality: 'Lille',
    addressCountry: 'FR',
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: [
      'Monday',
      'Tuesday',
      'Wednesday',
      'Thursday',
      'Friday',
      'Saturday',
      'Sunday',
    ],
    opens: '09:00',
    closes: '18:00',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 50.634337,
    longitude: 3.067457,
  },
  servesCuisine: 'Café',
  priceRange: '€',
  hasMenu: new URL('carte/', Astro.site).href,
  sameAs: [
    'https://www.instagram.com/lum_lille',
    'https://www.tiktok.com/@lum_vieuxlille',
  ],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(donneesStructurees)} />

    {/* Mesure d'audience Cloudflare : sans cookie, donc pas de bandeau de
        consentement à afficher. `is:inline` laisse la balise intacte, les
        attributs du beacon devant parvenir tels quels au navigateur. */}
    <script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "1499722904844b059bb5307b5585893e"}'></script>
  </head>
  <body>
    <slot />
  </body>
</html>
