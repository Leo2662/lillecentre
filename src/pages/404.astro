---
import BaseLayout from '../layouts/BaseLayout.astro';
import Entete from '../components/Entete.astro';

// Servie par GitHub Pages pour toute adresse inconnue, avec un statut 404 :
// plutôt qu'une impasse, un chemin vers l'accueil et la carte.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Page introuvable | LÜM Lille Centre" noindex>
  <div class="page">
    <Entete />

    <main class="panel">
      <div class="chip">
        <h1>Page introuvable</h1>
      </div>

      <p class="message">Cette page n'existe pas, ou plus. La carte, elle, est toujours là.</p>

      <div class="actions">
        <a class="lum-pill-btn" href={`${base}/`}>Accueil</a>
        <a class="lum-pill-btn" href={`${base}/carte/`}>
          Consulter la carte <span class="arrow">→</span>
        </a>
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: var(--page-max);
    min-height: 100vh;
    margin: 0 auto;
    padding: 28px var(--gutter) 64px;
  }

  .panel {
    position: relative;
    max-width: 820px;
    margin: 80px auto 0;
    padding: 80px 40px 56px;
    border-radius: var(--radius-lg);
    background: var(--cream);
    box-shadow: var(--shadow);
    text-align: center;
  }

  .chip {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    width: max-content;
    max-width: calc(100% - 40px);
    padding: 14px 34px;
    border: 3px solid var(--blue-light);
    border-radius: var(--radius);
    background: var(--cream);
  }

  h1 {
    font-size: clamp(1.8rem, 5vw, 2.8rem);
  }

  .message {
    max-width: 40ch;
    margin: 0 auto 30px;
    font-weight: 700;
    font-size: 1.05rem;
    text-wrap: balance;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }

  @media (max-width: 768px) {
    .panel {
      padding: 70px 22px 44px;
    }

    .chip {
      max-width: calc(100% - 32px);
      padding: 12px 22px;
    }
  }
</style>
