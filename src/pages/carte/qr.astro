---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { qrEnSvg } from '../../lib/qr';

// L'URL vient de `site` : si le domaine change, l'affiche suit.
const cible = new URL('carte/', Astro.site).href;

// Zone de silence laissée à 0 : c'est le calage CSS du bloc qui la fournit.
const qr = await qrEnSvg(cible);

const lisible = cible.replace(/^https:\/\//, '').replace(/\/$/, '');

// PDF pré-généré par `npm run affiche`, servi depuis public/.
const PDF = '/affiche-carte-lum.pdf';
---

<BaseLayout title="Affiche QR — LÜM Lille Centre" noindex>
  <div class="ecran-seulement barre">
    <p>Affiche A4, prête à imprimer.</p>
    <a class="lum-pill-btn lum-pill-btn--inverse" href={PDF} download>
      Enregistrer le PDF <span class="arrow">↓</span>
    </a>
  </div>

  <div class="affiche">
    <div class="cadre">
      <p class="marque">
        LÜM
        <small>Lille Centre</small>
      </p>

      <div class="cartouche">
        <h1>La carte</h1>
      </div>

      <div class="qr" set:html={qr} />

      <p class="consigne">Scannez pour découvrir la carte</p>
      <p class="consigne--en" lang="en">Scan for the menu</p>

      <p class="url">{lisible}</p>
    </div>
  </div>
</BaseLayout>

<style>
  /* --- Mise en page d'impression --- */
  @page {
    size: A4 portrait;
    margin: 0;
  }

  .affiche {
    width: 210mm;
    height: 297mm;
    padding: 12mm;
    background: #fff;
    color: var(--blue);
    /* Sans cela, les navigateurs retirent les aplats à l'impression. */
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  .cadre {
    height: 100%;
    padding: 14mm 12mm;
    border: 1.6mm solid var(--blue);
    border-radius: 6mm;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .marque {
    font-family: var(--font-display);
    font-size: 13mm;
    line-height: 1;
    letter-spacing: 0.06em;
  }

  .marque small {
    display: block;
    margin-top: 2mm;
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 3.4mm;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .cartouche {
    margin: 11mm 0 9mm;
    padding: 4mm 10mm;
    border: 1mm solid var(--blue);
    border-radius: 5mm;
  }

  .cartouche h1 {
    font-size: 16mm;
    line-height: 1;
  }

  /* Le blanc déborde du QR : c'est la zone de silence, sans laquelle les
     lecteurs peinent à accrocher le code. */
  .qr {
    padding: 6mm;
    background: #fff;
    line-height: 0;
  }

  .qr :global(svg) {
    width: 88mm;
    height: 88mm;
    display: block;
  }

  .consigne {
    margin-top: 9mm;
    font-family: var(--font-display);
    font-size: 7mm;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .consigne--en {
    margin-top: 2mm;
    font-weight: 700;
    font-size: 4.6mm;
    letter-spacing: 0.08em;
    color: var(--blue-light);
    text-transform: uppercase;
  }

  .url {
    margin-top: 11mm;
    font-weight: 800;
    font-size: 4.6mm;
    letter-spacing: 0.06em;
  }

  /* --- Confort à l'écran, jamais imprimé --- */
  .barre {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 20px var(--gutter);
    color: var(--cream);
    font-weight: 700;
    text-align: center;
  }

  @media print {
    .ecran-seulement {
      display: none;
    }
  }

  @media screen {
    .affiche {
      margin: 0 auto 40px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.35);
    }

    /* L'affiche fait 210 mm de large : on la réduit sur petit écran
       plutôt que d'imposer un défilement horizontal. */
    @media (max-width: 820px) {
      .affiche {
        transform: scale(0.42);
        transform-origin: top center;
        margin-bottom: calc(-297mm * 0.58 + 40px);
      }
    }
  }
</style>
