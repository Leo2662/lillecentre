---
import BaseLayout from '../layouts/BaseLayout.astro';
import Entete from '../components/Entete.astro';
import Bilingue from '../components/Bilingue.astro';
import BandeauConges from '../components/BandeauConges.astro';
import { ancre, montant, prixPlancherEnLettres, rubriques, vedettes } from '../data/carte';
import {
  ETABLISSEMENT,
  adresseEnLigne,
  horairesEnLigne,
  lienItineraire,
  telephoneEnLettres,
} from '../lib/etablissement';
import { noeudMenu } from '../lib/seo';

// Dans chaque rubrique, les articles les plus chers passent en tête. Le tri
// se fait ici, pas dans les données : un article ajouté n'importe où dans
// src/data/carte.ts prend de lui-même sa place. À prix égal, l'ordre des
// données est conservé.
const parPrixDecroissant = <T extends { prix: string }>(articles: T[]) =>
  [...articles].sort((a, b) => montant(b.prix) - montant(a.prix));

// Prix affichés sans le symbole € : la note en bas de carte précise la devise.
const sansDevise = (prix: string) => prix.replace(/\s*€$/, '');

const site = Astro.site!;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Titre du résultat Google : les plats que l'on cherche, puis la ville. À
// revoir si les plats en vedette changent. La description, elle, suit la
// carte : plats en vedette et prix d'appel viennent de src/data/carte.ts.
const titre = 'Tartes salées maison et pommes de terre garnies à Lille | LÜM';
const plats = vedettes.map((r) => `${r.titre.toLowerCase()} ${prixPlancherEnLettres(r)}`);
const description = `Repas faits maison à emporter chez ${ETABLISSEMENT.nom} : ${[...plats, 'pâtisseries, boissons et café'].join(', ')}.`;
---

<BaseLayout
  title={titre}
  description={description}
  filAriane={[{ nom: 'La carte', url: new URL('carte/', site).href }]}
  menu={noeudMenu(site)}
>
  <script is:inline>
    // Service du matin : de 8h00 à 11h45, la rubrique Barista passe en tête.
    // L'heure est celle de Paris, pas celle du visiteur : un client en
    // déplacement doit voir la carte du café, pas celle de son fuseau.
    // Intl gère le passage heure d'été / heure d'hiver tout seul.
    (function () {
      var DEBUT = 8 * 60;
      var FIN = 11 * 60 + 45;

      function minutesAParis() {
        var parts = new Intl.DateTimeFormat('fr-FR', {
          timeZone: 'Europe/Paris',
          hour: '2-digit',
          minute: '2-digit',
          hour12: false,
        }).formatToParts(new Date());
        var h, m;
        for (var i = 0; i < parts.length; i++) {
          if (parts[i].type === 'hour') h = parseInt(parts[i].value, 10);
          if (parts[i].type === 'minute') m = parseInt(parts[i].value, 10);
        }
        return h * 60 + m;
      }

      function appliquer() {
        try {
          var n = minutesAParis();
          document.documentElement.classList.toggle(
            'service-matin',
            n >= DEBUT && n < FIN
          );
        } catch (e) {
          // Fuseau indisponible : on garde l'ordre par défaut de la page.
        }
      }

      appliquer();
      // Une page laissée ouverte sur le comptoir doit basculer à 11h45.
      setInterval(appliquer, 30000);
    })();
  </script>

  <div class="page">
    <Entete />

    <h1 class="titre-page"><Bilingue fr="La carte" en="The Menu" /></h1>

    <div class="langues" role="group" aria-label="Langue de la carte / Menu language">
      <button type="button" class="langue" data-langue="fr" aria-pressed="true">FR</button>
      <button type="button" class="langue" data-langue="en" aria-pressed="false">EN</button>
    </div>

    <p class="intro">
      <Bilingue
        fr={`Repas faits maison, pâtisseries, boissons et café de spécialité\u00a0: toute la carte est disponible à emporter, au ${ETABLISSEMENT.adresse.rue} à Lille.`}
        en={`Homemade meals, pastries, drinks and specialty coffee: the whole menu is available to take away, at ${ETABLISSEMENT.adresse.rue}, Lille.`}
      />
    </p>

    <BandeauConges />

    <div class="rubriques">
      {
        rubriques.map((rubrique) => (
          <section
            id={ancre(rubrique)}
            class:list={['bloc', rubrique.matinale && 'bloc--matinale']}
          >
          <div class="chip">
            <h2>
              <Bilingue fr={rubrique.titre} en={rubrique.titreEn} />
            </h2>
          </div>

          {
            rubrique.intro && (
              <p class="bloc__intro">
                <Bilingue fr={rubrique.intro} en={rubrique.introEn ?? rubrique.intro} />
              </p>
            )
          }

          {
            rubrique.titre === 'Pommes de Terre Garnies' && (
              <p class="bloc__cta">
                <a class="lum-pill-btn" href={`${base}/click-and-collect/`}>
                  <Bilingue fr="Commander en click & collect" en="Order for pick-up" /> <span class="arrow">→</span>
                </a>
              </p>
            )
          }

          <ul
            class={rubrique.articles.length > 8 ? 'articles articles--deux' : 'articles'}
            style={`--lignes: ${Math.ceil(rubrique.articles.length / 2)}`}
          >
            {parPrixDecroissant(rubrique.articles).map((article) => (
              <li class="article">
                <div class="article__ligne">
                  <span class="article__nom">
                    <Bilingue fr={article.nom} en={article.nomEn} />
                  </span>
                  <span class="article__filet" aria-hidden="true" />
                  <span class="article__prix">
                    {article.aPartirDe && <><Bilingue fr="dès" en="from" />{'\u00a0'}</>}
                    {sansDevise(article.prix)}
                  </span>
                </div>
                {
                  article.description && (
                    <p class="article__desc">
                      <Bilingue fr={article.description} en={article.descriptionEn ?? article.description} />
                    </p>
                  )
                }
              </li>
            ))}
            </ul>
          </section>
        ))
      }
    </div>

    <footer class="pied">
      <p class="infos">
        {/* Un span de la page autour de chaque élément : le séparateur reste
            hors du soulignement des liens, et les styles de la page, limités
            à ses propres balises, l'atteignent. */}
        <span>{ETABLISSEMENT.nom}</span>
        <span>
          <a href={lienItineraire()} target="_blank" rel="noopener noreferrer">{adresseEnLigne()}</a>
        </span>
        <span><Bilingue fr={horairesEnLigne()} en={horairesEnLigne('en')} /></span>
        <span><a href={`tel:${ETABLISSEMENT.telephone}`}>{telephoneEnLettres()}</a></span>
      </p>

      <p class="note">
        <Bilingue
          fr="Prix en euros, taxes comprises."
          en="Prices in euros, taxes included."
        />
      </p>
    </footer>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 28px var(--gutter) 64px;
    display: flex;
    flex-direction: column;
    gap: 46px;
  }

  .titre-page {
    margin: 18px 0 0;
    text-align: center;
    font-size: clamp(2.6rem, 9vw, 5rem);
    color: var(--cream);
  }

  /* --- Sélecteur de langue --- */
  .langues {
    align-self: center;
    display: inline-flex;
    margin-top: -26px;
    border: 2px solid rgba(249, 241, 230, 0.55);
    border-radius: 999px;
    overflow: hidden;
  }

  .langue {
    padding: 5px 15px;
    border: 0;
    background: transparent;
    color: var(--cream);
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  .langue[aria-pressed='true'] {
    background: var(--cream);
    color: var(--blue);
  }

  .langue:not([aria-pressed='true']):hover {
    background: rgba(249, 241, 230, 0.15);
  }

  /* Une phrase de présentation sous le titre, sur le bleu. */
  .intro {
    max-width: 58ch;
    margin: -22px auto 4px;
    color: var(--cream);
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.6;
    text-align: center;
    text-wrap: balance;
  }

  .rubriques {
    display: flex;
    flex-direction: column;
    gap: 46px;
  }

  /* Service du matin : la rubrique Barista passe en tête. On joue sur l'ordre
     d'affichage plutôt que de déplacer le nœud, afin que le basculement soit
     déjà en place au premier rendu, sans saut visible. */
  :global(html.service-matin) .bloc--matinale {
    order: -1;
  }

  /* --- Bloc crème, avec cartouche de titre à cheval sur le bord --- */
  .bloc {
    position: relative;
    padding: 62px 34px 38px;
    border-radius: var(--radius-lg);
    background: var(--cream);
    box-shadow: var(--shadow);
    /* Arrivée par une ancre (#tartes-salees-du-jour) : le cartouche, qui
       déborde au-dessus du bloc, reste visible. */
    scroll-margin-top: 44px;
  }

  .bloc__intro {
    max-width: 52ch;
    margin: -10px auto 22px;
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1.5;
    text-align: center;
    color: var(--blue-light);
    text-wrap: balance;
  }

  .bloc__cta {
    margin: -6px 0 24px;
    text-align: center;
  }

  .chip {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    width: max-content;
    max-width: calc(100% - 40px);
    padding: 11px 28px;
    border: 3px solid var(--blue-light);
    border-radius: var(--radius);
    background: var(--cream);
  }

  .chip h2 {
    font-size: clamp(1.3rem, 3.4vw, 1.9rem);
  }

  /* --- Articles --- */
  .articles {
    list-style: none;
    /* Sur une colonne, on resserre : sinon les pointillés s'étirent */
    max-width: 720px;
    margin: 0 auto;
    padding: 0;
    display: grid;
    gap: 20px 46px;
  }

  /* Deux colonnes remplies l'une après l'autre, comme une carte imprimée :
     lue de haut en bas, chaque colonne reste triée par prix décroissant. */
  .articles--deux {
    max-width: none;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(var(--lignes), auto);
    grid-auto-flow: column;
  }

  .article__ligne {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .article__nom {
    font-weight: 800;
    font-size: 1.02rem;
  }

  .article__filet {
    flex: 1;
    min-width: 18px;
    border-bottom: 2px dotted var(--blue-light);
    transform: translateY(-5px);
  }

  .article__prix {
    font-weight: 800;
    font-size: 1.02rem;
    white-space: nowrap;
  }

  .article__desc {
    margin-top: 2px;
    max-width: 46ch;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--blue-light);
  }

  /* --- Pied de carte : où et quand, puis la note sur les prix --- */
  .pied {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .infos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    color: var(--cream);
    font-weight: 700;
    font-size: 0.95rem;
    text-align: center;
  }

  .infos > * + *::before {
    content: '·';
    margin: 0 10px;
    opacity: 0.6;
  }

  .infos a {
    border-bottom: 2px solid rgba(249, 241, 230, 0.45);
    transition: border-color 0.2s;
  }

  .infos a:hover,
  .infos a:focus-visible {
    border-bottom-color: var(--cream);
  }

  .note {
    text-align: center;
    color: var(--cream);
    font-size: 0.85rem;
    font-weight: 700;
    opacity: 0.75;
  }

  @media (max-width: 768px) {
    .bloc {
      padding: 56px 20px 32px;
    }

    /* Une information par ligne : un séparateur en début de ligne gênerait. */
    .infos {
      flex-direction: column;
      align-items: center;
      gap: 4px;
    }

    .infos > * + *::before {
      content: none;
    }

    .articles--deux {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      grid-auto-flow: row;
    }
  }
</style>

<script>
  const boutons = document.querySelectorAll('[data-langue]');
  const MEMOIRE = 'lum-langue';

  function appliquer(langue) {
    document.querySelectorAll('.t-fr').forEach((e) => {
      e.hidden = langue !== 'fr';
    });
    document.querySelectorAll('.t-en').forEach((e) => {
      e.hidden = langue !== 'en';
    });
    boutons.forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset.langue === langue));
    });
    document.documentElement.lang = langue;
  }

  boutons.forEach((b) => {
    b.addEventListener('click', () => {
      const langue = b.dataset.langue;
      appliquer(langue);
      // Le choix est propre au visiteur : localStorage peut échouer
      // (navigation privée, cookies bloqués), l'échec n'a rien de bloquant.
      try {
        localStorage.setItem(MEMOIRE, langue);
      } catch {}
    });
  });

  try {
    if (localStorage.getItem(MEMOIRE) === 'en') appliquer('en');
  } catch {}
</script>
