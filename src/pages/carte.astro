---
import BaseLayout from '../layouts/BaseLayout.astro';
import Entete from '../components/Entete.astro';
import Bilingue from '../components/Bilingue.astro';
import BanniereAvis from '../components/BanniereAvis.astro';
import { rubriques } from '../data/carte';
---

<BaseLayout
  title="La carte — LÜM"
  description="Focaccias, pâtisseries, boissons et café de spécialité à emporter chez LÜM."
>
  <div class="page">
    <Entete />

    <h1 class="titre-page"><Bilingue fr="La carte" en="The Menu" /></h1>

    <div class="langues" role="group" aria-label="Langue de la carte / Menu language">
      <button type="button" class="langue" data-langue="fr" aria-pressed="true">FR</button>
      <button type="button" class="langue" data-langue="en" aria-pressed="false">EN</button>
    </div>

    {
      rubriques.map((rubrique) => (
        <section class="bloc">
          <div class="chip">
            <h2>
              <Bilingue fr={rubrique.titre} en={rubrique.titreEn} />
            </h2>
          </div>

          <ul class={rubrique.articles.length > 8 ? 'articles articles--deux' : 'articles'}>
            {rubrique.articles.map((article) => (
              <li class="article">
                <div class="article__ligne">
                  <span class="article__nom">
                    <Bilingue fr={article.nom} en={article.nomEn} />
                  </span>
                  <span class="article__filet" aria-hidden="true" />
                  <span class="article__prix">{article.prix}</span>
                </div>
                {
                  article.description && (
                    <p class="article__desc">
                      <Bilingue fr={article.description} en={article.descriptionEn ?? article.description} />
                    </p>
                  )
                }
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <BanniereAvis />

    <p class="note">
      <Bilingue
        fr="Prix en euros, taxes comprises."
        en="Prices in euros, taxes included."
      />
    </p>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 28px var(--gutter) 64px;
    display: flex;
    flex-direction: column;
    gap: 46px;
  }

  .titre-page {
    margin: 18px 0 0;
    text-align: center;
    font-size: clamp(2.6rem, 9vw, 5rem);
    color: var(--cream);
  }

  /* --- Sélecteur de langue --- */
  .langues {
    align-self: center;
    display: inline-flex;
    margin-top: -26px;
    border: 2px solid rgba(249, 241, 230, 0.55);
    border-radius: 999px;
    overflow: hidden;
  }

  .langue {
    padding: 5px 15px;
    border: 0;
    background: transparent;
    color: var(--cream);
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  .langue[aria-pressed='true'] {
    background: var(--cream);
    color: var(--blue);
  }

  .langue:not([aria-pressed='true']):hover {
    background: rgba(249, 241, 230, 0.15);
  }

  /* --- Bloc crème, avec cartouche de titre à cheval sur le bord --- */
  .bloc {
    position: relative;
    padding: 62px 34px 38px;
    border-radius: var(--radius-lg);
    background: var(--cream);
    box-shadow: var(--shadow);
  }

  .chip {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    width: max-content;
    max-width: calc(100% - 40px);
    padding: 11px 28px;
    border: 3px solid var(--blue-light);
    border-radius: var(--radius);
    background: var(--cream);
  }

  .chip h2 {
    font-size: clamp(1.3rem, 3.4vw, 1.9rem);
  }

  /* --- Articles --- */
  .articles {
    list-style: none;
    /* Sur une colonne, on resserre : sinon les pointillés s'étirent */
    max-width: 720px;
    margin: 0 auto;
    padding: 0;
    display: grid;
    gap: 20px 46px;
  }

  .articles--deux {
    max-width: none;
    grid-template-columns: repeat(2, 1fr);
  }

  .article__ligne {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .article__nom {
    font-weight: 800;
    font-size: 1.02rem;
  }

  .article__filet {
    flex: 1;
    min-width: 18px;
    border-bottom: 2px dotted var(--blue-light);
    transform: translateY(-5px);
  }

  .article__prix {
    font-weight: 800;
    font-size: 1.02rem;
    white-space: nowrap;
  }

  .article__desc {
    margin-top: 2px;
    max-width: 46ch;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--blue-light);
  }

  .note {
    text-align: center;
    color: var(--cream);
    font-size: 0.85rem;
    font-weight: 700;
    opacity: 0.75;
  }

  @media (max-width: 768px) {
    .bloc {
      padding: 56px 20px 32px;
    }

    .articles--deux {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const boutons = document.querySelectorAll('[data-langue]');
  const MEMOIRE = 'lum-langue';

  function appliquer(langue) {
    document.querySelectorAll('.t-fr').forEach((e) => {
      e.hidden = langue !== 'fr';
    });
    document.querySelectorAll('.t-en').forEach((e) => {
      e.hidden = langue !== 'en';
    });
    boutons.forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset.langue === langue));
    });
    document.documentElement.lang = langue;
  }

  boutons.forEach((b) => {
    b.addEventListener('click', () => {
      const langue = b.dataset.langue;
      appliquer(langue);
      // Le choix est propre au visiteur : localStorage peut échouer
      // (navigation privée, cookies bloqués), l'échec n'a rien de bloquant.
      try {
        localStorage.setItem(MEMOIRE, langue);
      } catch {}
    });
  });

  try {
    if (localStorage.getItem(MEMOIRE) === 'en') appliquer('en');
  } catch {}
</script>
