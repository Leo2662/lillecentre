---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const liens = [
  {
    nom: 'Instagram',
    url: 'https://www.instagram.com/lum_lillecentre',
    // Appareil photo au trait, dans l'esprit des illustrations de l'affiche
    trace:
      'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4Z M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z M17.4 6.6h.01',
  },
  {
    nom: 'TikTok',
    url: 'https://www.tiktok.com/@lum_lillecentre',
    trace:
      'M14 3v12.2a3.8 3.8 0 1 1-3.2-3.75 M14 3c.4 2.6 2 4.2 4.6 4.5',
  },
];
---

<BaseLayout>
  <main class="stage">
    <section class="panel">
      <div class="chip">
        <h1>Hello&nbsp;world&nbsp;?</h1>
      </div>

      <p class="script">C'est le tout début du site LÜM</p>

      <svg class="cup" viewBox="0 0 120 110" role="img" aria-label="Tasse de café">
        <g
          fill="none"
          stroke="currentColor"
          stroke-width="4"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M18 34h68v34a26 26 0 0 1-26 26H44a26 26 0 0 1-26-26V34Z" />
          <path d="M86 44h10a14 14 0 0 1 0 28h-10" />
          <path d="M22 40h60" />
          <path d="M38 22c0-6 6-8 6-14" />
          <path d="M54 22c0-6 6-8 6-14" />
          <path d="M70 22c0-6 6-8 6-14" />
        </g>
      </svg>

      <p class="lede">
        Coffee shop &amp; vente à emporter, au cœur du Vieux-Lille.<br />
        Le café, les foccacias et les horaires arrivent très vite.
      </p>

      <a class="lum-pill-btn" href={`${base}/`}>
        Bientôt ici <span class="arrow">→</span>
      </a>

      <div class="reseaux">
        {
          liens.map((lien) => (
            <a
              class="reseau"
              href={lien.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`LÜM sur ${lien.nom}`}
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d={lien.trace}
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.9"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              <span>{lien.nom}</span>
            </a>
          ))
        }
      </div>
    </section>

    <footer class="pied">
      <p>
        {'Notre autre adresse\u00a0: '}
        <a href="https://lumvieuxlille.fr" target="_blank" rel="noopener noreferrer">
          lumvieuxlille.fr <span class="arrow">→</span>
        </a>
      </p>
    </footer>
  </main>
</BaseLayout>

<style>
  .stage {
    min-height: 100vh;
    padding: 40px var(--gutter);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 28px;
  }

  .panel {
    position: relative;
    width: 100%;
    max-width: 820px;
    margin-top: 34px;
    padding: 88px 40px 64px;
    border-radius: var(--radius-lg);
    background: var(--cream);
    box-shadow: var(--shadow);
    text-align: center;
    animation: fade-up 0.5s ease both;
  }

  /* Le cartouche du titre chevauche le bord du panneau, comme sur l'affiche */
  .chip {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    padding: 14px 34px;
    border: 3px solid var(--blue-light);
    border-radius: var(--radius);
    background: var(--cream);
  }

  h1 {
    font-size: clamp(2rem, 6vw, 3.4rem);
  }

  .script {
    font-family: var(--font-script);
    font-size: 1.6rem;
    line-height: 1.2;
  }

  .cup {
    display: block;
    width: 150px;
    margin: 28px auto 24px;
    color: var(--blue);
  }

  .lede {
    max-width: 46ch;
    margin: 0 auto 34px;
    font-weight: 700;
    font-size: 1.05rem;
    text-wrap: balance;
  }

  /* --- Réseaux sociaux, dans le panneau crème --- */
  .reseaux {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 38px;
    padding-top: 26px;
    border-top: 2px solid var(--cream-dark);
  }

  .reseau {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 9px 20px;
    border: 2.5px solid var(--blue);
    border-radius: 999px;
    font-weight: 800;
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: background 0.2s, color 0.2s;
  }

  .reseau svg {
    width: 20px;
    height: 20px;
  }

  .reseau:hover,
  .reseau:focus-visible {
    background: var(--blue);
    color: var(--cream);
  }

  /* --- Pied de page, sur le bleu --- */
  .pied {
    color: var(--cream);
    font-weight: 700;
    font-size: 0.95rem;
    text-align: center;
  }

  .pied a {
    border-bottom: 2px solid rgba(249, 241, 230, 0.45);
    padding-bottom: 1px;
    transition: border-color 0.2s;
  }

  .pied a:hover,
  .pied a:focus-visible {
    border-bottom-color: var(--cream);
  }

  .pied .arrow {
    display: inline-block;
    transition: transform 0.2s;
  }

  .pied a:hover .arrow {
    transform: translateX(3px);
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .panel {
      padding: 74px 22px 48px;
    }

    .chip {
      width: max-content;
      max-width: calc(100% - 32px);
      padding: 12px 22px;
    }
  }
</style>
