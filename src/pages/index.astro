---
import BaseLayout from '../layouts/BaseLayout.astro';
import BanniereAvis from '../components/BanniereAvis.astro';
import BandeauConges from '../components/BandeauConges.astro';
import {
  ETABLISSEMENT,
  horairesEnLigne,
  horairesEnPhrase,
  lienItineraire,
  telephoneEnLettres,
} from '../lib/etablissement';
import { ancre, prixPlancherEnLettres, rubriques, vedettes } from '../data/carte';
import Photo from '../components/Photo.astro';
import { photosPubliees } from '../data/photos';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Section des pommes de terre garnies : ses photos, et le lien vers leur
// rubrique sur la carte (ou vers la carte, si la rubrique change de nom).
const POMMES_DE_TERRE = 'pommes-de-terre-garnies';
const photosPommesDeTerre = photosPubliees().filter((p) => p.rubrique === POMMES_DE_TERRE);
const lienPommesDeTerre = rubriques.some((r) => ancre(r) === POMMES_DE_TERRE)
  ? `${base}/carte/#${POMMES_DE_TERRE}`
  : `${base}/carte/`;

// Titre et description du résultat Google. La requête visée ouvre le titre ;
// la description nomme les plats en vedette : à revoir s'ils changent.
const titre = `${ETABLISSEMENT.accroche} | ${ETABLISSEMENT.nom}`;
const description = `Déjeuner à emporter à Lille : tartes salées du jour faites maison et pommes de terre garnies, au ${ETABLISSEMENT.adresse.rue}. ${horairesEnLigne()}.`;

// « Sources préférées » de Google : le lien ouvre l'outil sur notre domaine,
// où le visiteur n'a plus qu'à cocher LÜM. Un simple lien plutôt que le
// bouton officiel, qui chargerait un script Google sur la page.
const sourcePreferee = `https://www.google.com/preferences/source?q=${Astro.site!.hostname}`;

const liens = [
  {
    nom: 'Instagram',
    url: 'https://www.instagram.com/lum_lille',
    // Appareil photo au trait, dans l'esprit des illustrations de l'affiche
    trace:
      'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4Z M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z M17.4 6.6h.01',
    // Chaque icône est recadrée au plus juste sur son tracé, demi-épaisseur
    // de trait comprise. Sans cela les deux glyphes, de tailles et de
    // proportions différentes, ne rendaient ni au même format ni avec les
    // mêmes marges, et les pilules paraissaient décentrées.
    boite: '2.05 2.05 19.9 19.9',
    trait: 1.9,
  },
  {
    nom: 'TikTok',
    url: 'https://www.tiktok.com/@lum_vieuxlille',
    trace:
      'M14 3v12.2a3.8 3.8 0 1 1-3.2-3.75 M14 3c.4 2.6 2 4.2 4.6 4.5',
    boite: '5.5635 2.1635 13.873 17.673',
    // Épaisseur compensée : ce cadrage est plus serré, donc davantage
    // agrandi ; sans correction le trait paraîtrait plus épais.
    trait: 1.673,
  },
];
---

<BaseLayout title={titre} description={description}>
  <main class="stage">
    <BandeauConges />

    <section class="panel">
      {/* L'accroche d'affiche garde son cartouche ; le titre de la page (h1)
          est la ligne qui dit ce que l'on est, plus bas. */}
      <div class="chip">
        <p class="lum-titre titre-affiche">Repas Gourmand</p>
      </div>

      <p class="script">On va lümer ?</p>

      {/* Pomme de terre au four, fumante : le plat phare, dessiné au trait
          comme les illustrations de l'affiche. */}
      <svg class="illustration" viewBox="0 0 120 110" role="img" aria-label="Pomme de terre fumante, dessinée au trait">
        <g
          fill="none"
          stroke="currentColor"
          stroke-width="4"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M15 68c-3-15 8-27 24-28 9-.5 13-5 22-7 6-1.5 11-1.5 17-1 17 1 29 13 27 30-2 17-17 29-40 30-11 .5-19-1-27-4-13-4-21-11-23-20Z" />
          {/* Les « yeux » sont semés de biais : alignés, ils dessinaient un visage. */}
          <path d="M32 60h.01 M71 46h.01 M55 79h.01 M91 67h.01" />
          <path d="M44 72c1.4 1.2 3.4 1.4 5 .6" />
          <path d="M84 52c.2 1.8 1.4 3.2 3 3.8" />
          <path d="M46 25c0-6 6-8 6-14" />
          <path d="M62 23c0-6 6-8 6-14" />
          <path d="M78 25c0-6 6-8 6-14" />
        </g>
      </svg>

      <h1 class="lede">{ETABLISSEMENT.accroche}</h1>

      <p class="adresse">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11Z" />
            <circle cx="12" cy="10" r="2.6" />
          </g>
        </svg>
        64 rue du Molinel, Lille
      </p>

      <p class="horaires">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5.2l3.4 2" />
          </g>
        </svg>
        {horairesEnLigne()}
      </p>

      <a class="lum-pill-btn" href={`${base}/carte/`}>
        Consulter la carte <span class="arrow">→</span>
      </a>
    </section>

    <BanniereAvis />

    {
      photosPommesDeTerre.length > 0 && (
        <section class="panel panel--plats" aria-labelledby="titre-pommes-de-terre">
          <div class="chip chip--section">
            <h2 id="titre-pommes-de-terre">Nos pommes de terre garnies maison à Lille</h2>
          </div>

          <p class="intro">
            De la cuisine maison, servie chaude et prête à emporter&nbsp;: nos pommes de terre
            garnies font un déjeuner complet, à savourer au bureau ou au parc. La garniture se
            choisit au comptoir.
          </p>

          {/* Une colonne de 360 px au plus par photo : d'où la valeur de sizes. */}
          <div class="photos">
            {photosPommesDeTerre.map((photo) => (
              <Photo photo={photo} sizes="(max-width: 452px) calc(100vw - 92px), 360px" />
            ))}
          </div>

          <p class="aussi">
            <a href={lienPommesDeTerre}>
              Voir les pommes de terre garnies sur la carte <span class="arrow" aria-hidden="true">→</span>
            </a>
          </p>
        </section>
      )
    }

    <section class="panel panel--plats" aria-labelledby="titre-plats">
      <div class="chip chip--section">
        <h2 id="titre-plats">Déjeuner à emporter</h2>
      </div>

      <p class="intro">Des repas faits maison, à commander au comptoir et à emporter.</p>

      <ul class="plats">
        {
          vedettes.map((rubrique) => (
            <li class="plat">
              <h3>
                <a href={`${base}/carte/#${ancre(rubrique)}`}>{rubrique.titre}</a>
              </h3>
              {rubrique.intro && <p class="plat__texte">{rubrique.intro}</p>}
              <p class="plat__prix">
                {prixPlancherEnLettres(rubrique)} <span class="arrow" aria-hidden="true">→</span>
              </p>
            </li>
          ))
        }
      </ul>

      <p class="aussi">
        Et aussi&nbsp;: pâtisseries, boissons et café de spécialité, sur{' '}
        <a href={`${base}/carte/`}>la carte complète</a>.
      </p>

      <div class="commander">
        <h3>Comment commander&nbsp;?</h3>
        <p>
          Passez au comptoir du {ETABLISSEMENT.adresse.rue}, {horairesEnPhrase()}, et repartez
          avec votre repas. Une question&nbsp;? Appelez le{' '}
          <a class="tel" href={`tel:${ETABLISSEMENT.telephone}`}>{telephoneEnLettres()}</a>.
        </p>
        <a class="lum-pill-btn" href={lienItineraire()} target="_blank" rel="noopener noreferrer">
          Itinéraire <span class="arrow">→</span>
        </a>
      </div>
    </section>

    <footer class="pied">
      <p>
        {'Notre second lieu\u00a0: '}
        <a href="https://lumvieuxlille.fr" target="_blank" rel="noopener noreferrer">
          LÜM Vieux-Lille <span class="arrow">→</span>
        </a>
      </p>

      <div class="reseaux">
        {
          liens.map((lien) => (
            <a
              class="reseau"
              href={lien.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`LÜM sur ${lien.nom}`}
            >
              <svg viewBox={lien.boite} aria-hidden="true">
                <path
                  d={lien.trace}
                  fill="none"
                  stroke="currentColor"
                  stroke-width={lien.trait}
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              <span>{lien.nom}</span>
            </a>
          ))
        }
      </div>

      <p class="source-google">
        <a href={sourcePreferee} target="_blank" rel="noopener noreferrer">
          Ajouter LÜM à vos sources préférées sur Google <span class="arrow">→</span>
        </a>
      </p>
    </footer>
  </main>
</BaseLayout>

<style>
  .stage {
    min-height: 100vh;
    padding: 40px var(--gutter);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 28px;
  }

  /* Le cartouche du titre déborde au-dessus du panneau : un peu d'air en
     plus pour qu'il ne frôle pas le bandeau des congés. */
  .stage :global(.conges) {
    margin-bottom: 14px;
  }

  .panel {
    position: relative;
    width: 100%;
    max-width: 820px;
    margin-top: 34px;
    padding: 88px 40px 64px;
    border-radius: var(--radius-lg);
    background: var(--cream);
    box-shadow: var(--shadow);
    text-align: center;
    animation: fade-up 0.5s ease both;
  }

  /* Le cartouche du titre chevauche le bord du panneau, comme sur l'affiche */
  .chip {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    width: max-content;
    max-width: calc(100% - 40px);
    padding: 14px 34px;
    border: 3px solid var(--blue-light);
    border-radius: var(--radius);
    background: var(--cream);
  }

  .titre-affiche {
    font-size: clamp(2rem, 6vw, 3.4rem);
  }

  .script {
    font-family: var(--font-script);
    font-size: 1.6rem;
    line-height: 1.2;
  }

  .illustration {
    display: block;
    width: 150px;
    margin: 28px auto 24px;
    color: var(--blue);
  }

  .adresse,
  .horaires {
    /* flex et non inline-flex : sinon l'adresse et le bouton se suivent
       sur la même ligne au lieu de s'empiler */
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 6px;
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: 0.03em;
  }

  .adresse svg,
  .horaires svg {
    width: 19px;
    height: 19px;
    flex: none;
  }

  .horaires {
    margin-bottom: 30px;
  }

  /* Le h1 garde l'allure de l'accroche qu'il remplace : texte courant, pas
     titre d'affiche (les titres reçoivent Anton en capitales par défaut). */
  .lede {
    max-width: 46ch;
    margin: 0 auto 26px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.05rem;
    line-height: inherit;
    letter-spacing: normal;
    text-transform: none;
    text-wrap: balance;
  }

  /* --- Déjeuner à emporter : plats en vedette et modalités --- */
  .panel--plats {
    padding: 70px 40px 48px;
    /* Sous la ligne de flottaison : pas d'entrée animée. */
    animation: none;
  }

  /* Cartouche de section, aux proportions de ceux de la carte. */
  .chip--section {
    padding: 11px 28px;
  }

  .chip--section h2 {
    font-size: clamp(1.3rem, 3.4vw, 1.9rem);
    text-wrap: balance;
  }

  /* Une colonne de 360 px au plus par photo : seule, elle reste centrée ;
     à deux, elles se partagent la largeur ; sur téléphone, tout s'empile. */
  .photos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, 360px));
    justify-content: center;
    gap: 24px 18px;
  }

  .intro {
    max-width: 46ch;
    margin: 0 auto 28px;
    font-weight: 700;
    font-size: 1.05rem;
    text-wrap: balance;
  }

  .plats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 18px;
  }

  .plat {
    position: relative;
    padding: 24px 22px 20px;
    border: 3px solid var(--blue-light);
    border-radius: var(--radius);
    transition: border-color 0.2s, transform 0.2s;
  }

  .plat:hover {
    border-color: var(--blue);
    transform: translateY(-2px);
  }

  .plat h3 {
    margin-bottom: 8px;
    font-size: clamp(1.3rem, 3vw, 1.6rem);
  }

  /* Toute la vignette est cliquable ; le lien reste le titre, qui lui donne
     un nom court et parlant. */
  .plat h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  .plat h3 a:focus-visible {
    outline: none;
  }

  .plat:has(a:focus-visible) {
    outline: 2px solid var(--blue);
    outline-offset: 4px;
  }

  .plat__texte {
    max-width: 34ch;
    margin: 0 auto;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--blue-light);
    text-wrap: balance;
  }

  .plat__prix {
    margin-top: 12px;
    font-weight: 800;
    font-size: 1.02rem;
    letter-spacing: 0.03em;
  }

  .plat__prix .arrow {
    display: inline-block;
    margin-left: 4px;
    transition: transform 0.2s;
  }

  .plat:hover .plat__prix .arrow {
    transform: translateX(4px);
  }

  .aussi {
    margin-top: 24px;
    font-weight: 700;
    font-size: 0.95rem;
    text-wrap: balance;
  }

  .aussi a,
  .tel {
    border-bottom: 2px solid rgba(24, 0, 172, 0.35);
    padding-bottom: 1px;
    transition: border-color 0.2s;
  }

  .aussi a:hover,
  .aussi a:focus-visible,
  .tel:hover,
  .tel:focus-visible {
    border-bottom-color: var(--blue);
  }

  .tel {
    white-space: nowrap;
  }

  .commander {
    margin-top: 34px;
    padding-top: 30px;
    border-top: 2px solid var(--cream-dark);
  }

  .commander h3 {
    margin-bottom: 10px;
    font-size: clamp(1.2rem, 3vw, 1.5rem);
  }

  .commander p {
    max-width: 50ch;
    margin: 0 auto 24px;
    font-weight: 600;
    line-height: 1.6;
    text-wrap: balance;
  }

  /* --- Réseaux sociaux, dans le pied de page sur le bleu --- */
  .reseaux {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    /* Sans contour, les deux liens ont besoin de plus d'air pour ne pas
       se lire comme un seul bloc. */
    gap: 30px;
    margin-top: 18px;
  }

  .reseau {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    /* Pas de contour, mais on garde ce calage : il assure une cible tactile
       confortable sans rien afficher. */
    padding: 9px 4px;
    color: var(--cream);
    font-weight: 800;
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: opacity 0.2s;
  }

  .reseau svg {
    /* Hauteur commune, largeur déduite des proportions du tracé : les deux
       icônes occupent ainsi exactement la place de leur dessin. */
    width: auto;
    height: 20px;
  }

  .reseau:hover {
    opacity: 0.7;
  }

  /* Le contour disparu, il faut rendre le focus clavier visible autrement. */
  .reseau:focus-visible {
    outline: 2px solid var(--cream);
    outline-offset: 5px;
    border-radius: 4px;
  }

  /* --- Pied de page, sur le bleu --- */
  .pied {
    color: var(--cream);
    font-weight: 700;
    font-size: 0.95rem;
    text-align: center;
  }

  .pied p a {
    border-bottom: 2px solid rgba(249, 241, 230, 0.45);
    padding-bottom: 1px;
    transition: border-color 0.2s;
  }

  .pied p a:hover,
  .pied p a:focus-visible {
    border-bottom-color: var(--cream);
  }

  .pied .arrow {
    display: inline-block;
    transition: transform 0.2s;
  }

  .pied p a:hover .arrow {
    transform: translateX(3px);
  }

  /* Discret : une invitation, pas un appel à l'action. */
  .source-google {
    margin-top: 14px;
    font-size: 0.82rem;
    opacity: 0.85;
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .panel {
      padding: 74px 22px 48px;
    }

    .chip {
      max-width: calc(100% - 32px);
      padding: 12px 22px;
    }

    .panel--plats {
      padding: 60px 22px 40px;
    }

    .chip--section {
      padding: 10px 20px;
    }
  }
</style>
