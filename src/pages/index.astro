---
import BaseLayout from '../layouts/BaseLayout.astro';
import BanniereAvis from '../components/BanniereAvis.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const liens = [
  {
    nom: 'Instagram',
    url: 'https://www.instagram.com/lum_lille',
    // Appareil photo au trait, dans l'esprit des illustrations de l'affiche
    trace:
      'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4Z M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z M17.4 6.6h.01',
    // Chaque icône est recadrée au plus juste sur son tracé, demi-épaisseur
    // de trait comprise. Sans cela les deux glyphes, de tailles et de
    // proportions différentes, ne rendaient ni au même format ni avec les
    // mêmes marges, et les pilules paraissaient décentrées.
    boite: '2.05 2.05 19.9 19.9',
    trait: 1.9,
  },
  {
    nom: 'TikTok',
    url: 'https://www.tiktok.com/@lum_vieuxlille',
    trace:
      'M14 3v12.2a3.8 3.8 0 1 1-3.2-3.75 M14 3c.4 2.6 2 4.2 4.6 4.5',
    boite: '5.5635 2.1635 13.873 17.673',
    // Épaisseur compensée : ce cadrage est plus serré, donc davantage
    // agrandi ; sans correction le trait paraîtrait plus épais.
    trait: 1.673,
  },
];
---

<BaseLayout>
  <main class="stage">
    <section class="panel">
      <div class="chip">
        <h1>Healthy and Gourmand</h1>
      </div>

      <p class="dates">Ouverture le jeudi 17 septembre</p>

      <p class="script">On va lümer ?</p>

      <svg class="cup" viewBox="0 0 120 110" role="img" aria-label="Tasse de café">
        <g
          fill="none"
          stroke="currentColor"
          stroke-width="4"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M18 34h68v34a26 26 0 0 1-26 26H44a26 26 0 0 1-26-26V34Z" />
          <path d="M86 44h10a14 14 0 0 1 0 28h-10" />
          <path d="M22 40h60" />
          <path d="M38 22c0-6 6-8 6-14" />
          <path d="M54 22c0-6 6-8 6-14" />
          <path d="M70 22c0-6 6-8 6-14" />
        </g>
      </svg>

      <p class="lede">Coffee &amp; Lunch to go</p>

      <p class="adresse">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11Z" />
            <circle cx="12" cy="10" r="2.6" />
          </g>
        </svg>
        64 rue du Molinel, Lille
      </p>

      <p class="horaires">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5.2l3.4 2" />
          </g>
        </svg>
        Tous les jours, 9h – 18h
      </p>

      <a class="lum-pill-btn" href={`${base}/carte`}>
        Consulter la carte <span class="arrow">→</span>
      </a>
    </section>

    <BanniereAvis />

    <footer class="pied">
      <p>
        {'Notre second lieu\u00a0: '}
        <a href="https://lumvieuxlille.fr" target="_blank" rel="noopener noreferrer">
          LÜM Vieux-Lille <span class="arrow">→</span>
        </a>
      </p>

      <div class="reseaux">
        {
          liens.map((lien) => (
            <a
              class="reseau"
              href={lien.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`LÜM sur ${lien.nom}`}
            >
              <svg viewBox={lien.boite} aria-hidden="true">
                <path
                  d={lien.trace}
                  fill="none"
                  stroke="currentColor"
                  stroke-width={lien.trait}
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              <span>{lien.nom}</span>
            </a>
          ))
        }
      </div>
    </footer>
  </main>
</BaseLayout>

<style>
  .stage {
    min-height: 100vh;
    padding: 40px var(--gutter);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 28px;
  }

  .panel {
    position: relative;
    width: 100%;
    max-width: 820px;
    margin-top: 34px;
    padding: 88px 40px 64px;
    border-radius: var(--radius-lg);
    background: var(--cream);
    box-shadow: var(--shadow);
    text-align: center;
    animation: fade-up 0.5s ease both;
  }

  /* Le cartouche du titre chevauche le bord du panneau, comme sur l'affiche */
  .chip {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    width: max-content;
    max-width: calc(100% - 40px);
    padding: 14px 34px;
    border: 3px solid var(--blue-light);
    border-radius: var(--radius);
    background: var(--cream);
  }

  h1 {
    font-size: clamp(2rem, 6vw, 3.4rem);
  }

  .dates {
    margin-top: 6px;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 3.2vw, 1.5rem);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .script {
    font-family: var(--font-script);
    font-size: 1.6rem;
    line-height: 1.2;
  }

  .cup {
    display: block;
    width: 150px;
    margin: 28px auto 24px;
    color: var(--blue);
  }

  .adresse,
  .horaires {
    /* flex et non inline-flex : sinon l'adresse et le bouton se suivent
       sur la même ligne au lieu de s'empiler */
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 6px;
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: 0.03em;
  }

  .adresse svg,
  .horaires svg {
    width: 19px;
    height: 19px;
    flex: none;
  }

  .horaires {
    margin-bottom: 30px;
  }

  .lede {
    max-width: 46ch;
    margin: 0 auto 26px;
    font-weight: 700;
    font-size: 1.05rem;
    text-wrap: balance;
  }

  /* --- Réseaux sociaux, dans le pied de page sur le bleu --- */
  .reseaux {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    /* Sans contour, les deux liens ont besoin de plus d'air pour ne pas
       se lire comme un seul bloc. */
    gap: 30px;
    margin-top: 18px;
  }

  .reseau {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    /* Pas de contour, mais on garde ce calage : il assure une cible tactile
       confortable sans rien afficher. */
    padding: 9px 4px;
    color: var(--cream);
    font-weight: 800;
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: opacity 0.2s;
  }

  .reseau svg {
    /* Hauteur commune, largeur déduite des proportions du tracé : les deux
       icônes occupent ainsi exactement la place de leur dessin. */
    width: auto;
    height: 20px;
  }

  .reseau:hover {
    opacity: 0.7;
  }

  /* Le contour disparu, il faut rendre le focus clavier visible autrement. */
  .reseau:focus-visible {
    outline: 2px solid var(--cream);
    outline-offset: 5px;
    border-radius: 4px;
  }

  /* --- Pied de page, sur le bleu --- */
  .pied {
    color: var(--cream);
    font-weight: 700;
    font-size: 0.95rem;
    text-align: center;
  }

  .pied p a {
    border-bottom: 2px solid rgba(249, 241, 230, 0.45);
    padding-bottom: 1px;
    transition: border-color 0.2s;
  }

  .pied p a:hover,
  .pied p a:focus-visible {
    border-bottom-color: var(--cream);
  }

  .pied .arrow {
    display: inline-block;
    transition: transform 0.2s;
  }

  .pied p a:hover .arrow {
    transform: translateX(3px);
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .panel {
      padding: 74px 22px 48px;
    }

    .chip {
      max-width: calc(100% - 32px);
      padding: 12px 22px;
    }
  }
</style>
