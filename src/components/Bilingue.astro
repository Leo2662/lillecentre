---
// Rend un texte dans les deux langues. Le français est visible par défaut :
// sans JavaScript, la page reste intégralement en français.
interface Props {
  fr: string;
  en: string;
}

const { fr, en } = Astro.props;
---

<span class="t-fr" lang="fr">{fr}</span><span class="t-en" lang="en" hidden>{en}</span>
