---
import Bilingue from './Bilingue.astro';
import { congesAAnnoncer } from '../lib/etablissement';

// Évalué au build : un déploiement postérieur à la réouverture n'affiche plus
// rien. Sans nouveau déploiement, le script en fin de bandeau le retire.
const conges = congesAAnnoncer();
---

{
  conges && (
    <aside class="conges">
      {/* Soleil au trait, dans l'esprit des illustrations de l'affiche */}
      <svg class="soleil" viewBox="0 0 48 48" aria-hidden="true">
        <g
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="24" cy="24" r="8.5" />
          <path d="M24 4v6 M24 38v6 M4 24h6 M38 24h6 M9.9 9.9l4.2 4.2 M33.9 33.9l4.2 4.2 M9.9 38.1l4.2-4.2 M33.9 14.1l4.2-4.2" />
        </g>
      </svg>

      <p class="titre">
        <Bilingue fr="L'équipe est en congé" en="The team is on holiday" />
      </p>

      <p class="periode">
        <Bilingue
          fr={`Le LÜM est fermé ${conges.fr.periode}.`}
          en={`LÜM is closed ${conges.en.periode}.`}
        />
      </p>

      <p class="retrouvailles">
        <Bilingue
          fr={`On se retrouve le ${conges.fr.reouverture} !`}
          en={`See you on ${conges.en.reouverture}!`}
        />
      </p>

      {/* Page encore en ligne après la réouverture : on retire le bandeau dès
          l'affichage. Date de Paris, pas celle du visiteur. */}
      <script is:inline define:vars={{ reouverture: conges.reouverture }}>
        try {
          var p = {};
          new Intl.DateTimeFormat('fr-FR', {
            timeZone: 'Europe/Paris',
            year: 'numeric',
            month: '2-digit',
            day: '2-digit',
          })
            .formatToParts(new Date())
            .forEach(function (x) {
              p[x.type] = x.value;
            });
          if (p.year + '-' + p.month + '-' + p.day >= reouverture) {
            document.currentScript.parentElement.remove();
          }
        } catch (e) {
          // Fuseau indisponible : mieux vaut un bandeau périmé qu'un plantage.
        }
      </script>
    </aside>
  )
}

<style>
  /* Contour crème sur le bleu : le bandeau se lit comme un avis affiché,
     distinct des panneaux crème qui portent le contenu du site. */
  .conges {
    width: 100%;
    max-width: 820px;
    margin: 0 auto;
    padding: 26px 28px 24px;
    border: 3px solid var(--cream);
    border-radius: var(--radius-lg);
    color: var(--cream);
    text-align: center;
    animation: fade-in 0.5s ease both;
  }

  .soleil {
    display: block;
    width: 44px;
    height: 44px;
    margin: 0 auto 10px;
  }

  .titre {
    margin-bottom: 8px;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4.4vw, 2.1rem);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.1;
  }

  .periode {
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: 0.03em;
    line-height: 1.45;
    text-wrap: balance;
  }

  .retrouvailles {
    margin-top: 6px;
    font-family: var(--font-script);
    font-size: 1.6rem;
    line-height: 1.2;
    text-wrap: balance;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (max-width: 768px) {
    .conges {
      padding: 22px 20px 20px;
    }
  }
</style>
